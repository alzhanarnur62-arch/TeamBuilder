# Скопируйте этот файл в .env и вставьте данные своего проекта Supabase
# (Project Settings → API Keys). Секретный ключ sb_secret_... сюда НЕ кладите.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# REST API для раздела «Жаңалықтар»
EXPO_PUBLIC_NEWS_API_URL=https://jsonplaceholder.typicode.com
